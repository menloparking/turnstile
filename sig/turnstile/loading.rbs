module Turnstile
  module Loading
    class Config
      attr_accessor resource_class: Class?
      attr_accessor id_param: Symbol?
      attr_reader action_modes: Hash[Symbol, Symbol]
      attr_reader custom_loaders: Hash[Symbol, Proc]

      # Parent resource settings
      attr_accessor parent_class: Class?
      attr_accessor parent_id_param: Symbol?
      attr_accessor parent_auto: bool

      def initialize: -> void
      def dup: -> Config
    end

    module Dsl
      module ClassMethods
        def turnstile_config: -> Config
        def auto_parent: -> void
        def load_singular: (*Symbol) -> void
        def load_plural: (*Symbol) -> void
        def load_resource: (Symbol) { (untyped) -> untyped } -> void
        def parent_resource: (Class, ?id_param: Symbol?) -> void
        def resource_class: (Class) -> void
        def resource_id_param: (Symbol | String) -> void
        def skip_loading: (*Symbol) -> void
      end
    end

    class Loader
      PLURAL_ACTIONS: Array[Symbol]
      SINGULAR_ACTIONS: Array[Symbol]
      SKIP_ACTIONS: Array[Symbol]

      attr_reader controller_class: Class
      attr_reader action_name: Symbol
      attr_reader params: untyped
      attr_reader current_user: untyped

      def initialize: (
        controller_class: Class,
        action_name: Symbol | String,
        params: untyped,
        current_user: untyped
      ) -> void

      def load: -> Hash[Symbol, untyped]

      private

      def config: -> Config
      def load_parent: -> untyped?
      def resolve_parent: -> [Class?, Symbol?]
      def detect_parent_from_params: -> [Class?, Symbol?]
      def parent_child_scope: (untyped) -> untyped?
      def find_association: (Class, Class) -> untyped?
      def resource_class: -> Class?
      def infer_resource_class: -> Class?
      def id_param: -> Symbol
      def singular_name: -> String?
      def plural_name: -> String?
      def skip_action?: -> bool
      def plural_action?: -> bool
      def singular_action?: -> bool
      def load_collection: (?base_scope: untyped?) -> Hash[Symbol, untyped]
      def load_singular: (?base_scope: untyped?) -> Hash[Symbol, untyped]
      def apply_policy_scope: (Class) -> untyped
    end
  end
end
